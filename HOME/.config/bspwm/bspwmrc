#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X
polybar ian &

bspc config focus_follows_pointer true

bspc config border_width         0
bspc config window_gap          14 

bspc config split_ratio          0.48
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Spotify state=floating
bspc rule -a OpenRGB state=floating
bspc rule -a Zathura state=floating
bspc rule -a st:forecast -o state=floating
bspc rule -a feh state=floating center=true
